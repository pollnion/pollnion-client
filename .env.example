# Environment Variables for Development
GITHUB_TOKEN=

# Determines stage variant of your application
EXPO_PUBLIC_APP_VARIANT= # development | preview | production

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API Configuration
REACT_APP_API_URL=https://api.example.com
REACT_APP_API_TIMEOUT=30000

# Environment Name
REACT_APP_ENV=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_CRASH_REPORTING=true
REACT_APP_ENABLE_BETA_FEATURES=false

# Expo Configuration
EXPO_PRIVATE_KEY=

# Optional: Deployment & Notifications
DEPLOY_WEBHOOK_URL=
SLACK_WEBHOOK_URL=